# ===========================================
# API DE EVENTOS
# ===========================================
# ATENÇÃO: Nunca commite o arquivo .env com valores reais!
# Copie este arquivo para .env.local e preencha com suas credenciais:
#   cp .env.example .env.local

# A integração com a API dedicada de eventos foi removida (ver SPRINT.md) —
# nenhum código lê NEXT_PUBLIC_API_BASE_URL no momento. A variável volta aqui
# quando a nova API for plugada.

# URL pública do site (usada para resolver URLs absolutas de metadata: og:image,
# canonical, sitemap). Default (se omitida): https://eventos.cafebugado.com.br
# NEXT_PUBLIC_SITE_URL=https://eventos.cafebugado.com.br

# ===========================================
# SENTRY (Error Tracking - Opcional)
# ===========================================
# Mesmo projeto/DSN do app antigo (era VITE_SENTRY_DSN lá) — só ativa em
# produção (NODE_ENV=production), fica sem-op em dev mesmo se preenchida.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

