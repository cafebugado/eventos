# ===========================================
# CONFIGURAÇÃO DO SUPABASE
# ===========================================
# ATENÇÃO: Nunca commite o arquivo .env com valores reais!
# Copie este arquivo para .env.local e preencha com suas credenciais:
#   cp .env.example .env.local

# URL do seu projeto Supabase (público — usado no browser e no servidor)
# Encontre em: Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon key) do Supabase (público — usado no browser e no servidor)
# Encontre em: Supabase Dashboard > Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# URL pública do site (usada para resolver URLs absolutas de metadata: og:image,
# canonical, sitemap). Default (se omitida): https://eventos.cafebugado.com.br
# NEXT_PUBLIC_SITE_URL=https://eventos.cafebugado.com.br

# ===========================================
# SENTRY (Error Tracking - Opcional)
# ===========================================
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

